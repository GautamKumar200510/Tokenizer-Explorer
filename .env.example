# ==============================================================================
# Tokenizer Explorer for Indian Languages - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your API keys.
# The app is 100% fully functional for all local tokenizers, Laplace smoothing,
# comparison charts, and language tax metrics even WITHOUT these optional API keys!

# Google Gemini API Key (Optional: for AI linguistic explanations & fairness insights)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Optional: for Whisper speech-to-text Hindi audio transcription)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Application Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./tokenizer_explorer.db
